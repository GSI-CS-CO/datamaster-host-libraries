{
    "build": {
        "dockerfile": "Containerfile",
        "context": "..",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "runArgs": [
        "--log-driver=none"
    ],
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "containerEnv": {
        "USER": "${localEnv:USER}",
        "BUILD_HOST": "${localEnv:HOSTNAME:-$(hostname)}"
    }

}